{
  "type": "object",
  "properties": {
    "stage_id": {
      "type": "string",
      "enum": [
        "00",
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09",
        "10",
        "11",
        "12",
        "13"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "blocked",
        "failed"
      ]
    },
    "next_stage_safe": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "result",
          "required",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "test_nodeids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "gate",
          "test_nodeids"
        ],
        "additionalProperties": false
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_issue": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "stage_id",
    "status",
    "next_stage_safe",
    "summary",
    "tests",
    "acceptance_checks",
    "changed_files",
    "evidence_paths",
    "unresolved_items",
    "blocking_issue"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
